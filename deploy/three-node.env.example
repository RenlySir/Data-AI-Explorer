# Copy to /etc/aegis-ai/aegis.env on each node and adjust only the role/ports.
AEGIS_DEPLOYMENT_VERSION=three-node-demo-20260820
AEGIS_API_PORT=18082
AEGIS_WEB_PORT=18081
AEGIS_NODE_ROLE=control
AEGIS_TIDB_ENDPOINTS=10.2.106.5,10.2.106.124,10.2.106.182
AEGIS_TIDB_SQL_PORT=4100
AEGIS_TIDB_STATUS_PORT=11080
AEGIS_TIDB_OPTIMIZER_HOST=10.2.106.5
AEGIS_TIDB_OPTIMIZER_PORT=4100
AEGIS_TIDB_OPTIMIZER_USER=root
AEGIS_TIDB_OPTIMIZER_PASSWORD=
AEGIS_TIDB_OPTIMIZER_DATABASE=aegis_demo
# TiDB-backed platform metadata (settings and audit events). The schema is
# created automatically on API startup; keep this database separate from
# business/demo data.
AEGIS_PLATFORM_DB_HOST=10.2.106.5
AEGIS_PLATFORM_DB_PORT=4100
AEGIS_PLATFORM_DB_USER=root
AEGIS_PLATFORM_DB_PASSWORD=
AEGIS_PLATFORM_DB_DATABASE=aegis_platform
AEGIS_NODE_EXPORTER_URL=http://127.0.0.1:9100/metrics
AEGIS_EXTERNAL_ADAPTER_MODE=demo
TIDB_MCP_ENDPOINT=
TIDB_MCP_ALLOWED_HOSTS=10.2.106.5,10.2.106.124,10.2.106.182
CHATBI_ALLOW_PRIVATE_HOSTS=true
CHATBI_ALLOWED_DB_HOSTS=10.2.106.5,10.2.106.124,10.2.106.182
MODEL_ALLOW_PRIVATE_HOSTS=true
MODEL_ALLOWED_HOSTS=
CORS_ALLOW_LOCALHOST=false
CORS_ALLOW_ORIGINS=http://10.2.106.5:18081
DATASET_ALLOWED_ROOTS=/opt/aegis-ai/data
DATASET_STORAGE_DIR=/opt/aegis-ai/data/datasets
