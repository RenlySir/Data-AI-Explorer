# Local development defaults. Copy to .env before starting Compose.
COMPOSE_PROJECT_NAME=data-ai-explorer
BACKEND_PORT=8080
WEB_PORT=5173
VITE_ENV=development
TIDB_IMAGE=pingcap/tidb:v8.5.2
TIDB_PORT=4000
TIDB_STATUS_PORT=10080
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

TIDB_HOST=tidb
TIDB_USER=root
TIDB_PASSWORD=
TIDB_DATABASE=aegis_demo
TIDB_READ_ENGINES=tikv,tiflash
TIDB_RESOURCE_GROUP=
AEGIS_PLATFORM_DB_HOST=tidb
AEGIS_PLATFORM_DB_PORT=4000
AEGIS_PLATFORM_DB_USER=root
AEGIS_PLATFORM_DB_PASSWORD=
AEGIS_PLATFORM_DB_DATABASE=aegis_platform
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Optional OpenAI-compatible model gateway used for Text2SQL.
MODEL_GATEWAY_BASE_URL=http://host.docker.internal:11434
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_MODEL=
# Direct model registration safety. Production should disable the private-host fallback and list exact hosts.
MODEL_ALLOW_PRIVATE_HOSTS=true
MODEL_ALLOWED_HOSTS=

# MCP/TiDB and local-file safety defaults.
TIDB_MCP_ENDPOINT=
# Comma-separated exact hostnames. Set this in production to restrict live MCP calls.
TIDB_MCP_ALLOWED_HOSTS=
# TiDB is the platform default. MySQL remains an optional external source adapter.
CHATBI_ALLOW_PRIVATE_HOSTS=false
CHATBI_ALLOWED_DB_HOSTS=tidb
DATASET_ALLOWED_ROOTS=/workspace/data
DATASET_STORAGE_DIR=/tmp/aegis-datasets

# Browser origins. Disable localhost matching in production and list exact HTTPS origins.
CORS_ALLOW_LOCALHOST=true
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
