# Local development defaults. Copy to .env before starting Compose.
COMPOSE_PROJECT_NAME=data-ai-explorer
BACKEND_PORT=8080
WEB_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_only
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Optional model gateway endpoint used by the future backend.
MODEL_GATEWAY_BASE_URL=http://host.docker.internal:11434
MODEL_GATEWAY_API_KEY=
